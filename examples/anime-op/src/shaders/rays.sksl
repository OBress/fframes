// Light rays fanning out of a point behind the subject, slowly turning, soft-edged.
uniform float3 iResolution;
uniform float iTime;
uniform float2 uCenter;
uniform float4 uColor;
uniform float uCount;

half4 main(float2 coord) {
    float2 d = coord - uCenter;
    float r = length(d);
    float a = atan(d.y, d.x) / 6.2831853 + 0.5 + iTime * 0.02;
    float x = a * uCount;
    float h = hash1(floor(x));
    float band = smoothstep(0.15, 0.35, fract(x)) * (1.0 - smoothstep(0.55 + 0.3 * h, 0.85 + 0.15 * h, fract(x)));
    float fade = smoothstep(0.0, 120.0, r) * (1.0 - smoothstep(iResolution.y * 0.3, iResolution.y * 1.1, r));
    float k = band * fade * (0.55 + 0.45 * h);
    return half4(uColor.rgb * uColor.a * k, uColor.a * k);
}
