// A fighting aura: cel-shaded flame tongues licking up and out of a body, two hard-edged
// tones, redrawn on twos. "Up" is the element's -y: rotate the layer to stream it.
uniform float3 iResolution;
uniform float iTime;
uniform float4 uInner;
uniform float4 uOuter;
uniform float uPower;
uniform float uSeed;

half4 main(float2 coord) {
    float2 q = (coord / iResolution.xy - float2(0.5, 0.62)) * float2(2.0, 1.7);
    float t = floor(iTime * 12.0) / 12.0;
    float r = length(q * float2(1.0, 0.8));
    float ang = atan(q.y, q.x);
    float up = clamp(-q.y / max(r, 1e-3), 0.0, 1.0);
    // tongues: noise around the body, travelling outwards with time
    float n = fbm(float2(ang * 2.6 + uSeed, t * 3.0 - r * 2.2));
    float tongue = pow(n, 1.5);
    float edge = uPower * (0.34 + 0.3 * tongue + 0.85 * up * up * tongue);
    float outer = 1.0 - smoothstep(edge - 0.01, edge + 0.01, r);
    float inner = 1.0 - smoothstep(edge * 0.66 - 0.01, edge * 0.66 + 0.01, r);
    // the body itself is not covered by the light: the aura burns around it
    float hollow = smoothstep(0.18, 0.3, r) ;
    inner *= hollow;
    float alpha = max(outer * uOuter.a, inner * uInner.a);
    float3 rgb = mix(uOuter.rgb, uInner.rgb, inner);
    return half4(rgb * alpha, alpha);
}
